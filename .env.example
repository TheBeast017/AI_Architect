# Engineering Design Agent Environment Variables Example
# Copy this file to .env and fill in real values before running with LLM features.

# LLM API Keys (required for Gemini or Anthropic-powered extraction)
# Get a free Gemini key at: https://aistudio.google.com/apikey
# Get an Anthropic key at: https://console.anthropic.com
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: specify which LLM model to use by default
ENGAGENT_LLM_MODEL=gemini-2.0-flash